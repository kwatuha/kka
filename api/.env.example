# Copy to `api/.env` when running the API outside Docker (nodemon from `api/`).
# Docker Compose loads Zoom + other vars from the project root `.env` — see `../.env.example`.
#
# `api/config/load-env.js` loads in order: API_ENV_FILE (if set), then this file, then repo root `.env`, then cwd `.env`.
# Variables already set (e.g. by Docker) are never overwritten.

# Zoom Meeting SDK (embedded telemedicine video)
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# Aliases (same values as Client ID / Client Secret from Zoom Marketplace)
# ZOOM_MEETING_SDK_KEY=
# ZOOM_MEETING_SDK_SECRET=

# --- Daily.co (default telemedicine video — auto room create + in-page embed) ---
# Dashboard → Developers → API key: https://dashboard.daily.co/
# DAILY_API_KEY=your_daily_api_key
# Optional display name override in SMS (already covered by SMS_FACILITY_NAME)

# --- Advanta Africa QuickSMS (patient notifications) ---
# Portal: https://quicksms.advantasms.com — same account/sender as Machakos when shared.
# ADVANTA_PARTNER_ID=7026
# ADVANTA_API_KEY=your_api_key_from_advanta_dashboard
# ADVANTA_SHORT_CODE=RHNsectPro
# Prefer sendsms for transactional HMIS alerts (set true only for OTP-style sends):
# ADVANTA_USE_OTP_ROUTE=false
# SMS_ENABLED=true
# Login OTP (when enabled in Administration → System configuration) uses Advanta sendotp + SMTP:
# SMTP_HOST= SMTP_USER= SMTP_PASS= (see docs/DHA_OPS_CRON_RUNBOOK.md)
# Optional emergency override without DB toggle: LOGIN_OTP_ENABLED=true
# Optional display name in SMS text (defaults to APP_NAME / NEXT_PUBLIC_APP_BRAND):
# SMS_FACILITY_NAME=IntelliNex
# Public booking CORS (comma-separated Origins of hospital websites that embed /book):
# PUBLIC_CORS_ORIGINS=https://www.hospital-website.example,https://hospital-website.example
# WhatsApp click-to-chat on the confirmation page (Kenya number, with or without 254):
# WHATSAPP_BUSINESS_NUMBER=0782900090

# --- M-Pesa STK Push via Cloudsasa (docs/MPESA_STK_INTEGRATION_GUIDE.md) ---
# Request client_id / client_secret from Cloudsasa; never expose them to the browser.
# CLOUD_SASA_CLIENT_ID=
# CLOUD_SASA_CLIENT_SECRET=
# Public HTTPS callback Cloudsasa will POST payment results to (must not be localhost):
# MPESA_CALLBACK_URL=https://intellinex.intellibizafrica.co.ke/api/billing/mpesa/callback
# Optional overrides:
# MPESA_STK_URL=https://idyangu.cloudsasa.com/api/wallet/app/stk-push
# MPESA_INTERNAL_API_BASE=http://127.0.0.1:3001

