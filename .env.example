# Copy this file to `.env` in the project root and adjust. Restart services after changes.
#
# Docker Compose project name (optional). If set, networks are named ${COMPOSE_PROJECT_NAME}_default.
# Use intellinex for this codebase; avoid legacy names like kiplombehmis unless you intentionally share a project.
# COMPOSE_PROJECT_NAME=intellinex
#
# Used by:
# - Next.js (NEXT_PUBLIC_*)
# - docker-compose `api` + `frontend` services (env_file: .env) — same file supplies ZOOM_*, DB_*, JWT_*, etc.
#
# Production: keep this file next to `docker-compose.deploy.yml` on the server (e.g. ~/intellinex/.env).
# If your secrets live elsewhere, either symlink that path to `.env` here, add a second path under `env_file:`
# in docker-compose.deploy.yml, or set API_ENV_FILE=/full/path/.env for the Node API (see api/config/load-env.js).
# API_ENV_FILE=
#
# --- API base URL (required for static export + split hosting) ---
# Baked in at `npm run build`. Must be reachable from users' browsers (use HTTPS in production).
# Static app on shared hosting + API on VPS (see basePath /hmis in next.config.mjs):
#   NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:3001
#   If the public site is HTTPS, the API should be HTTPS too (reverse proxy) or the browser may block mixed content.
NEXT_PUBLIC_API_URL=http://localhost:3101

# Product (generic platform) and app-brand (specific deployment) naming.
# Example:
# - IntelliNex generic: NEXT_PUBLIC_PRODUCT_NAME=IntelliNex, NEXT_PUBLIC_APP_BRAND=IntelliNex
# - Kiplombe deployment: NEXT_PUBLIC_PRODUCT_NAME=IntelliNex, NEXT_PUBLIC_APP_BRAND=Kiplombe
# - Kakamega county: NEXT_PUBLIC_PRODUCT_NAME=IntelliNex, NEXT_PUBLIC_APP_BRAND=Kakamega HMIS
NEXT_PUBLIC_PRODUCT_NAME=IntelliNex
NEXT_PUBLIC_APP_BRAND=Kakamega HMIS
# Brand logos in /public
# NEXT_PUBLIC_LOGO_PATH=/az-careplus-logo.png
# NEXT_PUBLIC_LOGO_SIDEBAR_PATH=/az-careplus-logo-sidebar.png
# NEXT_PUBLIC_LOGO_PRINT_PATH=/az-careplus-logo-print.png
# Optional hospital contact (public booking page). Leave blank to hide that card.
# NEXT_PUBLIC_HOSPITAL_WEBSITE=https://www.hospital.example
# NEXT_PUBLIC_HOSPITAL_LOCATION=
# NEXT_PUBLIC_HOSPITAL_PHONE=
# NEXT_PUBLIC_HOSPITAL_HOURS=
# Telemedicine POC clone only (hides scoped-down modules — see lib/telemedicine-scope.ts):
# NEXT_PUBLIC_EXPERIENCE_PACK=telemedicine
# DHA assessor UI scale-down on Kakamega deploy (nav hide only — see docs/DHA_UI_SCALE_DOWN.md):
# NEXT_PUBLIC_EXPERIENCE_PACK=dha-cert

# National Blood Bank (NBTMS) variant — DHA RMNCAH tender scaffold (see docs/NBTMS_VARIANT.md):
# NEXT_PUBLIC_NBTMS_ENABLED=1

# Public URL of the deployed UI (QR codes, absolute links). With basePath `/hmis`, include the path:
#   NEXT_PUBLIC_BASE_URL=https://your-domain.com/hmis
# NEXT_PUBLIC_BASE_URL=http://localhost:3100/hmis
# Optional: show Administration → compliance walkthrough & export panels (default off)
# NEXT_PUBLIC_SHOW_COMPLIANCE_TOOLING=1
#
# cPanel subdomain reverse-proxying to the VPS (e.g. hmis.example.com → http://VPS_IP:3102):
#   1) After SSL on the subdomain: NEXT_PUBLIC_BASE_URL=https://hmis.example.com/hmis
#   2) API URL must match page scheme — if the site is HTTPS, use an HTTPS API URL or same-origin /api proxy.
#   3) On the API server: FRONTEND_URL=https://hmis.example.com (origin only, no /hmis) for CORS.
# PORT/HOST for the UI are not set in app code; Docker publishes HMIS_FRONTEND_PORT (e.g. 3102) and HOSTNAME=0.0.0.0.

# --- Zoom Meeting SDK (embedded video in HMIS) — read by Node API only, not exposed to the browser ---
# From Zoom Marketplace → your Meeting SDK app → App Credentials (Client ID / Client Secret).
# Same as ZOOM_MEETING_SDK_KEY / ZOOM_MEETING_SDK_SECRET if you prefer those names.
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# --- Daily.co (default telemedicine video; API only) ---
# Dashboard → Developers → API key: https://dashboard.daily.co/
# DAILY_API_KEY=

# --- Advanta Africa QuickSMS (patient notifications; API only) ---
# Portal: https://quicksms.advantasms.com — same account/sender as Machakos when shared.
# ADVANTA_PARTNER_ID=7026
# ADVANTA_API_KEY=your_api_key_from_advanta_dashboard
# ADVANTA_SHORT_CODE=RHNsectPro
# ADVANTA_USE_OTP_ROUTE=false
# SMS_ENABLED=true
# SMS_FACILITY_NAME=IntelliNex

# --- M-Pesa STK Push via Cloudsasa (API only — see docs/MPESA_STK_INTEGRATION_GUIDE.md) ---
# CLOUD_SASA_CLIENT_ID=
# CLOUD_SASA_CLIENT_SECRET=
# MPESA_CALLBACK_URL=https://intellinex.intellibizafrica.co.ke/api/billing/mpesa/callback

# Running API without Docker: copy these lines into `api/.env` if you use dotenv there, or export in shell.

# --- docker-compose.shared-mysql.yml (reuse host MySQL container, e.g. `db` on network projects_default) ---
# Docker network name that the MySQL container is attached to (see: docker inspect db --format '{{json .NetworkSettings.Networks}}')
# EXTERNAL_MYSQL_DOCKER_NETWORK=projects_default
# Hostname of the MySQL container on that network (Compose service name from the other stack)
# DB_HOST=db
# DB_PORT=3306
# DB_USER=intellinex_hmis_user
# DB_PASSWORD=...
# DB_NAME=your_database
# (Optional Docker-style aliases; if set, they override DB_* for the container: MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE)
# Published port for Next container (host 3000 is often already used)
# HMIS_FRONTEND_PORT=3102
# API_PORT=3001
# Browser + CORS: public URL of the API and of the app (set before frontend build / runtime)
# NEXT_PUBLIC_API_URL=https://your-vps:3001
# FRONTEND_URL=https://your-vps:3102
#
# --- Static UI + remote API (recommended split deploy) ---
# 1) Root .env: set NEXT_PUBLIC_API_URL + NEXT_PUBLIC_BASE_URL (above), then: npm run build
# 2) Upload everything under out/ to public_html/hmis/ on static hosting (include .htaccess).
# 3) API server: cp deploy/env.api-server.example deploy/.env.api-server, set secrets + FRONTEND_URL, deploy API.
#    FRONTEND_URL must be the static site Origin only, e.g. https://lau.lambdahoster.com (no /hmis path).
# Telemedicine: ZOOM_* on API; register that domain in Zoom Meeting SDK app settings; COOP/COEP on static host if needed.
#
# For deploy/import-local-db-to-remote-db.sh (remote `db` container root — not the app user):
# REMOTE_MYSQL_ROOT_PASSWORD=

