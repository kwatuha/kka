# Next.js static export + basePath `/hmis`: deploy this file as `public_html/hmis/.htaccess`
# Clean URLs: /hmis/login → login.html, /hmis/queue/service → queue/service.html

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /hmis/

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]
</IfModule>

# Optional: allow the hospital website to embed /hmis/book (iframe).
# Add extra frame-ancestors origins here at deploy time if needed.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/book#">
    Header always unset X-Frame-Options
    Header always set Content-Security-Policy "frame-ancestors 'self'"
  </If>
</IfModule>
