# Copy to deploy/.env.kakamega (gitignored), then:
#   Shared MySQL on VPS: REMOTE_MYSQL_ROOT_PASSWORD=… ./deploy/setup-kakamega-db-remote.sh
#   Deploy: LOCAL_ENV_FILE=./deploy/.env.kakamega ./deploy/deploy-kakamega-shared-mysql.sh
#
# Public URLs (dual host — same HMIS):
#   https://kakamega.intellibizafrica.co.ke/hmis/  (county)
#   https://hmis.azimkim.co.ke/hmis/               (AZIMKIM / DHA)
# Guide: deploy/HMIS_DUAL_PUBLIC_URL.md
# Proxy: cpanel .htaccess examples OR deploy/nginx-kakamega-dual-public-host.conf on VPS
#
# Ports: above IntelliNex / telemed / Baringo (3122/5382/8286).

NODE_ENV=production
COMPOSE_PROJECT_NAME=intellinex-kakamega

# --- Branding (baked into frontend at build; DHA application: AZ CarePlus) ---
NEXT_PUBLIC_PRODUCT_NAME="AZ CarePlus"
NEXT_PUBLIC_APP_BRAND="AZ CarePlus"
APP_NAME="AZ CarePlus"
APP_BRAND="AZ CarePlus"
SMS_FACILITY_NAME="AZ CarePlus"
FHIR_META_SOURCE="AZ-CarePlus-HMIS"
FHIR_AUTHOR_DISPLAY="AZ CarePlus HMIS"
EVIDENCE_PRODUCT_NAME="AZ CarePlus HMIS"
TOTP_ISSUER="AZ CarePlus"
DHA_APPLICATION_ID="DHS-1790683976496-C791HNX7L"
DHA_PORTAL_APP_ID="APP-2026-K6UPM3"
DHA_ORGANISATION="AZIMKIM INVESTMENTS LIMITED"
DHA_CERTIFICATION_MIGRATION_LEVEL="129"
NEXT_PUBLIC_DHA_APPLICATION_ID="DHS-1790683976496-C791HNX7L"
# DHA assessor UI scale-down (nav only — code/APIs stay). Toggle:
#   ./scripts/dha-ui-scale-down.sh on|off
# Docs: docs/DHA_UI_SCALE_DOWN.md — modules: lib/dha-cert-scope.ts
# NEXT_PUBLIC_EXPERIENCE_PACK=dha-cert
# NEXT_PUBLIC_SHOW_COMPLIANCE_TOOLING=1
# Full HMIS for post-approval clients: leave NEXT_PUBLIC_EXPERIENCE_PACK unset (run scale-down off).

# --- Host ports on VPS ---
API_PORT=3222
HMIS_FRONTEND_PORT=5400
MYSQL_PORT=3330

# --- Shared MySQL on the same server ---
EXTERNAL_MYSQL_DOCKER_NETWORK=projects_default
DB_HOST=db
DB_PORT=3306
DB_USER=kakamega_user
DB_PASSWORD=
DB_NAME=kakamega_hmis_db

# Used only by setup-kakamega-db-remote.sh
# REMOTE_MYSQL_ROOT_PASSWORD=

# Required in production: random string, 32+ characters (API will not start otherwise)
JWT_SECRET=
# Loopback M-Pesa invoice payment header (16+ random chars; required in production)
MPESA_INTERNAL_SECRET=
# Never set in production: DISABLE_API_AUTH=1
# Optional: ALLOW_PUBLIC_USER_REGISTRATION=1 (default off in production)
# Optional: SERVE_UPLOADS_PUBLIC=1 (insecure — anonymous /uploads access)
# Optional: JSON_BODY_LIMIT=10mb

# Public URLs: nginx same-origin /api → leave NEXT_PUBLIC_API_URL empty.
# Direct IP deploy (UI :5400, API :3222) → set e.g. NEXT_PUBLIC_API_URL=http://YOUR_VPS:3222
# and add http://YOUR_VPS:5400 to PUBLIC_CORS_ORIGINS.
NEXT_PUBLIC_API_URL=
# Dual-host: omit NEXT_PUBLIC_BASE_URL at build so each hostname keeps its own origin in the browser.
# NEXT_PUBLIC_BASE_URL=https://hmis.azimkim.co.ke/hmis
# Canonical origin for DHA / evidence (no /hmis path)
DHA_PUBLIC_APP_URL=https://hmis.azimkim.co.ke
FRONTEND_URL=https://hmis.azimkim.co.ke,https://kakamega.intellibizafrica.co.ke
PUBLIC_CORS_ORIGINS=https://hmis.azimkim.co.ke,https://kakamega.intellibizafrica.co.ke

API_BASE_URL=http://kakamega_api:3001
PORT=3001

# Optional hospital contact (public booking + default letterhead fallback)
NEXT_PUBLIC_HOSPITAL_LOCATION=Kisumu-Kakamega Road, Kakamega
NEXT_PUBLIC_HOSPITAL_PHONE=0720 295739 / 0758 721989
NEXT_PUBLIC_HOSPITAL_HOURS=Open 24 hours
# NEXT_PUBLIC_HOSPITAL_WEBSITE=

# --- M-Pesa STK — full guide: docs/MPESA_DARAJA_SETUP.md (secrets go in deploy/.env.kakamega only) ---
# MPESA_PROVIDER=daraja
# MPESA_ENV=sandbox
# MPESA_DARAJA_CONSUMER_KEY=
# MPESA_DARAJA_CONSUMER_SECRET=
# MPESA_DARAJA_PASSKEY=
# MPESA_DARAJA_SHORTCODE=174379
# MPESA_CALLBACK_URL=https://hmis.azimkim.co.ke/api/billing/mpesa/callback
# Cloudsasa alternative: MPESA_PROVIDER=cloudsasa + CLOUD_SASA_CLIENT_ID/SECRET
# Paybill in UI: Administration → M-Pesa (e.g. 1269093 / AZ)

# --- SMS / video (fill when ready) ---
# ADVANTA_PARTNER_ID=
# ADVANTA_API_KEY=
# ADVANTA_SHORT_CODE=
# SMS_ENABLED=false
# IDSR_ALERT_SMS=254712345678
# IDSR_ALERT_SMS_ENABLED=true
# DAILY_API_KEY=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# --- Phase 1: RabbitMQ integration spine ---
RABBITMQ_USER=hmis
RABBITMQ_PASSWORD=hmis
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
RABBITMQ_URL=amqp://hmis:hmis@kakamega_rabbitmq:5672
RABBITMQ_EXCHANGE=hmis.events
OUTBOX_POLL_MS=5000

# AfyaConnect (OAuth — from https://afyaconnect.dha.go.ke/hie-api ; never commit secrets)
# Consumer Key/Secret from portal onboarding; token URL from your app's Postman/OpenAPI export.
# UAT middleware (common): https://ilm-dev.dha.go.ke/uat-middleware/api/v1/tenants/token → use body
# AFYACONNECT_TOKEN_URL=https://ilm-dev.dha.go.ke/uat-middleware/api/v1/tenants/token
# AFYACONNECT_CLIENT_ID=
# AFYACONNECT_CLIENT_SECRET=
# AFYACONNECT_SCOPE=
# AFYACONNECT_TOKEN_AUTH_METHOD=body
# Plan: docs/DHA_AFYACONNECT_GO_LIVE_PLAN.md
# UAT CR smoke: docs/DHA_UAT_CR_TEST_IDS.md · workflows: docs/DHA_CLIENT_REGISTRY_WORKFLOWS.md

# Phase 2 — Client Registry / Facility Registry (sandbox default; set live + URLs for MoH)
CLIENT_REGISTRY_MODE=sandbox
# AfyaConnect CR (after OAuth works): base from portal — examples:
#   fetch-client v3: https://api-uat.dha.go.ke
#   middleware v1:   https://ilm-dev.dha.go.ke/uat-middleware/api/v1
# CLIENT_REGISTRY_BASE_URL=
# CLIENT_REGISTRY_API_STYLE=fetch-client-v3
# CLIENT_REGISTRY_AGENT=
# Legacy static Bearer (only if not using OAuth):
# CLIENT_REGISTRY_API_KEY=
FACILITY_REGISTRY_MODE=sandbox
# AfyaConnect FR (same middleware root as CR):
# FACILITY_REGISTRY_MODE=live
# FACILITY_REGISTRY_BASE_URL=https://ilm-dev.dha.go.ke/uat-middleware/api/v1
# FACILITY_REGISTRY_API_STYLE=search-v1
# FACILITY_REGISTRY_DEFAULT_IDENTIFIER_TYPE=fr-code
# UAT smoke: docs/DHA_UAT_FR_TEST_IDS.md
# Legacy KMHFR-style:
# FACILITY_REGISTRY_BASE_URL=https://kmhfr.health.go.ke/api
# FACILITY_REGISTRY_API_KEY=

# Phase 3 — FHIR R4 / SHR (AfyaConnect middleware)
FHIR_MODE=sandbox
# FHIR_MODE=live
# FHIR_BASE_URL=https://ilm-dev.dha.go.ke/uat-middleware/api/v1
# FHIR_PUBLISH_STYLE=shr-bundles-v1
# Live transmit doc + smoke: docs/DHA_FHIR_LIVE_TRANSMIT.md (node api/scripts/test-afyaconnect-fhir.js)
# SHR consent/read (Week 4): docs/DHA_WEEK4_SHR_CONSENT_READ.md
# SHR_FACILITY_FR_CODE=FID-47-105963-0
# SHR_DEFAULT_PRACTITIONER_PUID=
# SHR_DEFAULT_REQUESTED_BY=Registration Clerk
# SHR_CONSENT_TOKEN_TTL_HOURS=12
# FHIR_PROFILE_SET=kenya-core
# Production: block live /shr/bundles until national visit consent is approved
# SHR_REQUIRE_CONSENT_FOR_PUBLISH=1
# branches.frCode (migration 142) or SHR_FACILITY_FR_CODE on server
# Legacy OpenHIM channel:
# FHIR_PUBLISH_STYLE=openhim-fhir
# FHIR_API_KEY=

# Phase 4 — IDSR / DHIS2 / SHA
IDSR_MODE=sandbox
# IDSR_BASE_URL=
# IDSR_API_KEY=
DHIS2_MODE=sandbox
# DHIS2_BASE_URL=
# DHIS2_ORG_UNIT=15915
# DHIS2_API_KEY=
SHA_MODE=sandbox
# SHA_BASE_URL=
# SHA_API_KEY=
# Eligibility (AfyaConnect middleware — confirm path in portal Postman)
# ELIGIBILITY_MODE=sandbox
# ELIGIBILITY_MODE=live
# AFYACONNECT_ELIGIBILITY_PATH=/patients/eligibility
# Preflight eligibility smoke (UAT default national ID from DHA CR docs)
# AFYACONNECT_PREFLIGHT_ELIGIBILITY_ID=12345678
# AFYACONNECT_PREFLIGHT_ELIGIBILITY_TYPE=National ID
# eClaims read paths (confirm in AfyaConnect Postman)
# AFYACONNECT_PARENT_BENEFITS_PATH=/patients/benefits
# AFYACONNECT_SUB_BENEFITS_PATH=/patients/sub-benefits
# AFYACONNECT_INTERVENTIONS_PATH=/patients/benefits/interventions
# AFYACONNECT_PREFLIGHT_ECLAIMS_CR_ID=   # optional override when DHA gives IP-enabled UAT CR
# IP witness probe: node scripts/test-afyaconnect-eclaims-ip-readiness.js (exit 2 = OP-only member)
# eClaims visit consent + start visit (confirm paths in AfyaConnect Postman)
# AFYACONNECT_CONTACTS_PATH=/patients/contacts
# AFYACONNECT_CLAIMS_OTP_PATH=/claims/otp
# Biometrics consent (POST /claims/authorize) — hardware agent + workstation from local server /status
# AFYACONNECT_CLAIMS_AUTHORIZE_PATH=/claims/authorize
# AFYACONNECT_CLAIMS_AUTHORIZE_REJECT_PATH=/claims/authorizations/{token}/reject
# AFYACONNECT_BIOMETRICS_AGENT_ID=
# AFYACONNECT_BIOMETRICS_WORKSTATION_ID=
# AFYACONNECT_BIOMETRICS_EKYC_PROVIDER_ID=
# AFYACONNECT_BIOMETRICS_DEVICE_OS=linux
# AFYACONNECT_CLAIMS_VISIT_PATH=/claims/visit
# Preauth: DHA middleware uses POST multipart /preauths (not /claims/preauth) — https://hie-docs.dha.go.ke/eclaims/preauths
# AFYACONNECT_CLAIMS_PREAUTH_PATH=/preauths
# Optional legacy JSON body to same path: AFYACONNECT_CLAIMS_PREAUTH_USE_JSON=1
# Specialty variants share /preauths with extra form fields — override only if Postman differs:
# AFYACONNECT_CLAIMS_PREAUTH_SURGICAL_PATH=/preauths
# AFYACONNECT_CLAIMS_PREAUTH_ONCOLOGY_PATH=/preauths
# AFYACONNECT_CLAIMS_PREAUTH_ELECTIVE_PATH=/preauths
# AFYACONNECT_CLAIMS_PREAUTH_CANCEL_PATH=/preauths/cancel
# AFYACONNECT_CLAIMS_SUBMIT_PATH=/claims/submit
# AFYACONNECT_CLAIMS_DISCHARGE_PATH=/claims/discharge
# AFYACONNECT_CLAIMS_ADD_LINE_PATH=/claims/interventions
# AFYACONNECT_CLAIMS_RETIRE_LINE_PATH=/claims/interventions/retire
# AFYACONNECT_CLAIMS_SWITCH_LINE_PATH=/claims/interventions/switch
# AFYACONNECT_CLAIMS_CLOSE_PATH=/claims/close
# Attending doctor on national claim (KMPDC reg — required before submit)
# AFYACONNECT_CLAIM_DOCTOR_ID_TYPE=registration_number
# AFYACONNECT_CLAIM_DOCTOR_ID_NUMBER=   # real KMPDC reg only — never paste doc placeholders
# AFYACONNECT_CLAIM_DOCTOR_REGULATION_BODY=KMPDC
# AFYACONNECT_PREFLIGHT_HWR_REGISTRATION=A7000   # optional override for preflight HWR row
# AFYACONNECT_CLAIMS_DOCTORS_PATH=/claims/doctors
# AFYACONNECT_CLAIMS_DIAGNOSES_PATH=/claims/diagnoses
# ICD-11 when submit finds no claim diagnosis (override per request with icdCode)
# AFYACONNECT_CLAIM_DEFAULT_ICD11=ca07.0
# AFYACONNECT_HWR_PROFESSIONALS_PATH=/professionals
# Do not set PUID as registration_number — national HWR rejects it. Only enable for experiments:
# AFYACONNECT_CLAIM_DOCTOR_ALLOW_PUID_FALLBACK=1
# Optional: node scripts/test-afyaconnect-claim-doctor.js attach test on active visit
# AFYACONNECT_CLAIM_DOCTOR_SMOKE_CONSENT_TOKEN=

# DHA ops — cron service tokens (see docs/DHA_OPS_CRON_RUNBOOK.md)
# MOH_EXPORT_API_URL=http://127.0.0.1:3222
# MOH_EXPORT_CRON_TOKEN=generate-long-random-secret
# IDSR_CRON_TOKEN=generate-long-random-secret
# Optional: comma-separated Kenya mobiles for immediate IDSR alerts (facility duty phone)
# IDSR_ALERT_SMS=254712345678,254798765432
# Integration failure alerts (outbox failed / FHIR live error) — defaults to IDSR_ALERT_SMS if unset
# INTEGRATION_ALERT_SMS=254712345678
# INTEGRATION_ALERT_EMAIL=ict@facility.example
# INTEGRATION_ALERT_ENABLED=true
# INTEGRATION_ALERT_COOLDOWN_MS=3600000
# IDSR_ALERT_SMS_ENABLED=true
# IDSR_ALERT_SMS_IMMEDIATE_ONLY=true
# IDSR_ALERT_EMAIL=duty@facility.example,idsr@county.example
# IDSR_ALERT_EMAIL_ENABLED=true
# IDSR_ALERT_EMAIL_IMMEDIATE_ONLY=true
# Optional pharmacy stock/alert emails (comma-separated)
# PHARMACY_ALERT_EMAIL=pharmacy@facility.example

# Local API test scripts (test_encounter_prepopulation.sh — not for production deploy)
# HMIS_TEST_USER=
# HMIS_TEST_PASSWORD=

# SMTP (required for real IDSR email delivery — see api/lib/smtpMailer.js)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AZ CarePlus HMIS <noreply@facility.example>"
# SMTP_SECURE=false

