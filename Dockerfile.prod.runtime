# syntax=docker/dockerfile:1.5
# Runtime install + build on container start (slow on small VPS; use Dockerfile.prod for production).
# Used by docker-compose.fast-deploy.yml and docker-compose.deploy-fast.yml (volume-mounted source).

FROM node:18-slim

RUN apt-get update && apt-get install -y \
    bash \
    curl \
    wget \
    python3 \
    make \
    g++ \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
COPY tsconfig.json next.config.mjs tailwind.config.ts postcss.config.mjs components.json ./
COPY app/ ./app/
COPY components/ ./components/
COPY lib/ ./lib/
COPY public/ ./public/
COPY styles/ ./styles/
COPY hooks/ ./hooks/
COPY scripts/ ./scripts/
COPY nginx/ ./nginx/
COPY deploy/ ./deploy/

COPY docker-entrypoint-prod.sh /entrypoint.sh
COPY docker-entrypoint-fast.sh /entrypoint-fast.sh
RUN chmod +x /entrypoint.sh /entrypoint-fast.sh

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

ENTRYPOINT ["/entrypoint.sh"]
