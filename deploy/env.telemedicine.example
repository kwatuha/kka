# Copy to deploy/.env.telemedicine (gitignored), then deploy with:
#   LOCAL_ENV_FILE=./deploy/.env.telemedicine ./deploy/deploy-telemedicine-shared-mysql.sh
#
# Subdomain: https://telemed.intellibizafrica.co.ke
# Proxy: deploy/cpanel-telemed-subdomain-proxy.htaccess.example → document root .htaccess
# Ports are main stack +10 (main API 3001 / UI 3102 → telemed 3011 / 3112).

NODE_ENV=production
COMPOSE_PROJECT_NAME=intellinex-telemed

# --- Branding + experience pack (baked into frontend at build) ---
NEXT_PUBLIC_PRODUCT_NAME=IntelliNex
NEXT_PUBLIC_APP_BRAND=IntelliNex Telemed
NEXT_PUBLIC_EXPERIENCE_PACK=telemedicine
SMS_FACILITY_NAME=IntelliNex Telemed

# --- Host ports (main HMIS uses ~3001 / ~3102) ---
API_PORT=3011
HMIS_FRONTEND_PORT=3112
# HMIS_HTTPS_PORT=8443

# --- Shared MySQL on the same server ---
EXTERNAL_MYSQL_DOCKER_NETWORK=projects_default
DB_HOST=db
DB_PORT=3306
DB_USER=telemed_user
DB_PASSWORD=
DB_NAME=intellinex_telemed_db

# Used only by setup-telemedicine-db-remote.sh (not by the API process)
# REMOTE_MYSQL_ROOT_PASSWORD=

JWT_SECRET=

# Public URLs via cPanel subdomain proxy (same-origin /api — leave API URL empty)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BASE_URL=https://telemed.intellibizafrica.co.ke/hmis
FRONTEND_URL=https://telemed.intellibizafrica.co.ke

API_BASE_URL=http://telemed_api:3001
PORT=3001

# --- Telemedicine video ---
# DAILY_API_KEY=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# --- SMS (optional) ---
# ADVANTA_PARTNER_ID=
# ADVANTA_API_KEY=
# ADVANTA_SHORT_CODE=
# SMS_ENABLED=true
