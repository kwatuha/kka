# Apache (cPanel) — reverse proxy for Kakamega County HMIS subdomain
#   https://kakamega.intellibizafrica.co.ke
#
# Upstream on VPS:
#   UI:  http://VPS_IP:5400/hmis/...
#   API: http://VPS_IP:3222/api/...
#
# Copy into the kakamega.* document root as `.htaccess`.
# SSL via cPanel AutoSSL on the subdomain.
#
# Smoke test from cPanel host (if SSH):
#   curl -sS -o /dev/null -w '%{http_code}\n' http://165.22.227.234:5400/hmis/
#   curl -sS -o /dev/null -w '%{http_code}\n' http://165.22.227.234:3222/

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  SSLProxyEngine On

  <IfModule mod_headers.c>
    RequestHeader set X-Forwarded-Proto "https" env=HTTPS
    RequestHeader set X-Forwarded-Host "%{HTTP_HOST}e"
  </IfModule>

  # API first (same-origin /api when NEXT_PUBLIC_API_URL is empty)
  RewriteRule ^api/(.*)$ http://165.22.227.234:3222/api/$1 [P,L]

  # UI under basePath /hmis
  # https://kakamega.../        → http://VPS:5400/hmis/
  # https://kakamega.../login   → http://VPS:5400/hmis/login
  RewriteRule ^(.*)$ http://165.22.227.234:5400/hmis/$1 [P,L]
</IfModule>

<IfModule mod_proxy.c>
  ProxyRequests Off
</IfModule>
